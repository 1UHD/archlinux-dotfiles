[global]
#display
follow = mouse
width = (200, 360)
height = (60, 600)
origin = top-right
offset = (5, 5)
indicate_hidden = yes
notification_limit = 5
gap_size = 5
padding = 10
horizontal_padding = 10
corner_radius = 14
frame_width = 1

#progress bar
progress_bar_corner_radius = 2
progress_bar_height = 10

#colors
highlight = "#7AA2F7"
foreground = "#cdd6f4"
frame_color = "#3a3a3c"

#text
font = "SF Pro 12"
markup = full
format = "<span foreground='#ffffff'><b>%s</b></span>\n%b"
alignment = left

#icons
icon_position = left
icon_theme = Papirus-Dark
enable_recursive_icon_lookup = true

[urgency_low]
background = "#1c1c1eb3"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1c1c1eb3"
foreground = "#cdd6f4"

[urgency_critical]
background = "#131e22b3"
foreground = "#cdd6f4"

[mymute]
max_icon_size = 20

[mydeafen]
max_icon_size = 20

[youtube-music]
appname = "com.github.th_ch.youtube_music"
max_icon_size = 40