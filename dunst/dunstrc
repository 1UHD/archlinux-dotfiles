[global]
#display
width = (0, 350)
height = (0, 600)
origin = top-right
offset = (10, 0)
indicate_hidden = yes
notification_limit = 5
gap_size = 5
padding = 10
horizontal_padding = 10
corner_radius = 0
frame_width = 0

#progress bar
progress_bar_corner_radius = 2
progress_bar_height = 10

#colors
highlight = "#7AA2F7"
foreground = "#cdd6f4"

#text
font = "SF Pro 12"
markup = full
format = "<span foreground='#ffffff'><b>%s</b></span>\n%b"
alignment = left

#icons
icon_position = left
icon_theme = Papirus-Dark
enable_recursive_icon_lookup = true

[urgency_low]
background = "#131e22b3"
foreground = "#cdd6f4"

[urgency_normal]
background = "#131e22b3"
foreground = "#cdd6f4"

[urgency_critical]
background = "#131e22b3"
foreground = "#cdd6f4"

[mymute]
max_icon_size = 20

[mydeafen]
max_icon_size = 20

[youtube-music]
appname = "com.github.th_ch.youtube_music"
max_icon_size = 40