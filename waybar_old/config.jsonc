{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "margin-top": 10,
    "margin-left": 20,
    "margin-right": 20,
    "height": 40,
    "modules-left": ["custom/archlogo", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/cpu", "custom/gpu", "pulseaudio#microphone", "pulseaudio", "bluetooth", "network", "tray", "clock"],

    "hyprland/window": {
        "format": "{}"
    },

    "custom/archlogo": {
        "format":"󰣇",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "on-click": "activate",
        "persistent_workspaces": false
    },

    "custom/cpu": {
        "format": "{}",
        "tooltip": false,
        "interval": 2,
        "exec": "~/.config/waybar/scripts/cpu.sh"
    },

    "custom/gpu": {
        "format": "{}",
        "tooltip": false,
        "interval": 2,
        "exec": "~/.config/waybar/scripts/gpu.sh"
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰌘 ",
        "format-disconnected": "<span foreground='#f38ba8'> </span>",
        "tooltip-format": "{essid}\nStrength: {signalStrength}%"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "<span foreground='#f38ba8'></span>",
        "tooltip-format": "Linked: {num_connections}"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "",
        "on-click": "pamixer --default-source -t",
        "tooltip-format": "{volume}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": false,
        "format-muted": "",
        "on-click": "pamixer -t",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "clock": {
        "format": "{0:%b %e  %R}",
        "interval": 1,
        "tooltip": false
    }
}