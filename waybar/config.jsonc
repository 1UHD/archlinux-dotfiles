{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "height": 50,
    "modules-left": ["custom/archlogo", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/cpu", "custom/gpu", "network", "tray", "clock"],

    "hyprland/window": {
        "format": "{}"
    },

    "custom/archlogo": {
        "format":"󰣇",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "on-click": "activate",
        "persistent_workspaces": false
    },

    "custom/cpu": {
        "format": "{}",
        "tooltip": false,
        "interval": 2,
        "exec": "~/.config/waybar/scripts/cpu.sh"
    },

    "custom/gpu": {
        "format": "{}",
        "tooltip": false,
        "interval": 2,
        "exec": "~/.config/waybar/scripts/gpu.sh"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰌘 LAN",
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "clock": {
        "format": "{0:%H:%M:%S}",
        "interval": 1
    }
}