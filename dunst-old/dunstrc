[global]
#display
width = (0, 350)
height = (0, 600)
origin = top-right
offset = (20, 20)
indicate_hidden = yes
notification_limit = 5
gap_size = 15
padding = 10
horizontal_padding = 10
corner_radius = 10
frame_width = 2
frame_color = "#2c2c2c"

#progress bar
progress_bar_corner_radius = 5
progress_bar_height = 10

#colors
highlight = "#c5003c"
foreground = "#cdd6f4"

#text
font = "SF Pro 12"
markup = full
format = "<span foreground='#c5003c'><b>%s</b></span>\n%b"
alignment = left

#icons
icon_position = left
icon_theme = Papirus-Dark
enable_recursive_icon_lookup = true

[urgency_low]
background = "#1c1c1c"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1c1c1c"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1c1c1c"
foreground = "#cdd6f4"

[mymute]
max_icon_size = 20

[mydeafen]
max_icon_size = 20